// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "SeniorPD Workshop",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:bullseye",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"moby": true
		},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers-extra/features/vue-cli:2": {}
	},
	"containerEnv": {
		"POETRY_VIRTUALENVS_IN_PROJECT": "true",
		"POETRY_VIRTUALENVS_CREATE": "true"
	},
	"postCreateCommand": "python3 -m pip install --user --upgrade poetry && echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> /home/vscode/.bashrc",
	"forwardPorts": [5000, 5173, 5432]
}
